# CtrlB Seeker Service Environment Configuration
# Copy this file to .env and customize the values for your environment

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================

# Application Environment
# Values: DEV, STAGING, PROD
ENV=PROD

# Server Configuration
PORT=8095

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# MongoDB connection string with authentication
# Replace with your actual MongoDB Atlas or self-hosted MongoDB URL
DB_HOST=mongodb://localhost:27017
DB_NAME=prod-db

# ============================================================================
# JWT TOKEN CONFIGURATION
# ============================================================================

# Paths to your RSA key files (relative to working directory)
# These files should be placed in the keys/ directory
JWT_PRIVATE_KEY_PATH=./keys/private.key
JWT_PUBLIC_KEY_PATH=./keys/public.key

# ============================================================================
# AUTHENTICATION & API CONFIGURATION
# ============================================================================

# Base64 encoded authentication header
# Update this with your actual encoded credentials
AUTH_HEADER="YsndsUSADsddsensse=="

# API Endpoints
LAKE_URL=http://127.0.0.1:8080
LAMBDA_ENABLED=false

# External Service URLs
ARTEMIS_URL=https://artemis.ctrlb.ai
FRONTEND_URL=https://flow.ctrlb.ai

# ============================================================================
# WORKSPACE CONFIGURATION
# ============================================================================

# Set this to match your workspace name in Artemis
# Example: tamasha.live, myworkspace.com, etc.
WORKSPACE_NAME=workspace.navem

# ============================================================================
# WORKER & QUEUE CONFIGURATION
# ============================================================================

# Number of alert processing workers
ALERT_WORKER_COUNT=5

# Maximum capacity for alert queue
ALERT_QUEUE_CAPACITY=1000

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ============================================================================
# SERVICE STATISTICS
# ============================================================================

# Service statistics method
# 0 = default method, 1 = tamasha-like aggregation
SERVICE_STATS_METHOD=0

